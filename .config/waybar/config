{
	"layer": "top",
	"position": "top",
	"reload_style_on_change": true,

	"height": 30,

	"modules-left": [
		"wlr/taskbar"
	],

	"modules-center": [
		"ext/workspaces",
		"custom/mango-layout",
		"custom/mango-keymode"
	],

	"modules-right": [
		"tray",
		"custom/mango-language",
		"systemd-failed-units",
		"custom/pacman",
		"custom/aur",
		"custom/webcam",
		"custom/firewall",
		"wireplumber",
		"wireplumber#source",
		"bluetooth",
		"network",
		"clock",
		"battery",
		"custom/power"
	],

	// ── Left ──
	"wlr/taskbar": {
		"all-outputs": false,
		"format": "{name}",
		"icon-size": 20,
		"tooltip-format": "{title}",
		"active-first": false,
		"on-click": "activate",
		"on-click-middle": "close",
		"on-click-right": "minimize",
		"rewrite": {
			"Thunar File Manager": "  Thunar",
			"Firefox": "  Firefox",
			"Mozilla Firefox": "  Firefox",
			"Firefox PDF": "  PDF",
			"Foot": "  Foot",
			"Foot Client": "  Foot",
			"Lite XL": "  Lite XL",
			// Raw app_id of Lite XL until waybar finds its desktop file (after a waybar restart)
			"com\\.lite_xl\\.LiteXL": "  Lite XL",
			"Steam": "  Steam",
		}
	},

	// ── Right ──
	"tray": {
		"icon-size": 16,
		"spacing": 10
	},

	// Tags of this monitor: busy ones and the shown one
	"ext/workspaces": {
		"format": "{name}",
		"on-click": "activate",
		"ignore-hidden": true
	},

	// ── mango (mmsg) ──

	// Layout of the tag on this bar's monitor; the tooltip says how it works.
	// Click and Super+N cycle through circle_layout in ~/.config/mango/general.toml
	"custom/mango-layout": {
		"exec": "mmsg watch all-monitors | jq --unbuffered -c --argjson l \"$(mmsg get layouts)\" '.monitors[] | select(.name == env.WAYBAR_OUTPUT_NAME) | $l.layouts[.layout_index].name | {text: ., alt: .}'",
		"return-type": "json",
		"exec-on-event": false,
		"hide-empty-text": true,
		"format": "  {}",
		"tooltip-format": "<b>Layout:</b> {}\n{icon}\n\nLeft click: next layout (Super+N)\nRight click: back to fair",
		"on-click": "mmsg dispatch switch_layout",
		"on-click-right": "mmsg dispatch setlayout,fair",
		"format-icons": {
			"tile": "Master window on the left,\nthe others stacked on the right",
			"right_tile": "Master window on the right,\nthe others stacked on the left",
			"center_tile": "Master window in the middle,\nthe others stacked left and right",
			"vertical_tile": "Master window on top,\nthe others side by side below",
			"scroller": "Every window is a column on a strip wider than the screen;\nfocus scrolls it (like niri or PaperWM)",
			"vertical_scroller": "Scroller with rows:\nthe strip scrolls up and down",
			"monocle": "One window fills the screen,\nthe others wait behind it as tabs",
			"deck": "Master window on the left,\nthe others as tabs on the right",
			"vertical_deck": "Master window on top,\nthe others as tabs below",
			"grid": "All windows in an even grid",
			"vertical_grid": "All windows in an even grid,\nfilled column by column",
			"fair": "A grid without empty cells:\nthe columns share the screen fairly",
			"vertical_fair": "Fair with rows instead of columns"
		}
	},

	// Key mode ([bind.<mode>] in keybindings.toml), only while it isn't default
	"custom/mango-keymode": {
		"exec": "mmsg watch keymode | jq --unbuffered -r '.keymode | if . == \"default\" then \"\" else . end'",
		"exec-on-event": false,
		"hide-empty-text": true,
		"format": "✌️ {}",
		"tooltip": false
	},

	// Keyboard layout, short; the tooltip has the full name
	"custom/mango-language": {
		"exec": "mmsg watch keyboardlayout | jq --unbuffered -c '.layout | {text: (if startswith(\"Slovenian\") then \"SI\" elif startswith(\"Spanish\") then \"ES\" else .[:2] | ascii_upcase end), tooltip: (\"<b>Keyboard:</b> \" + . + \"\\n\\nLeft click or Alt+Shift: next layout\")}'",
		"return-type": "json",
		"exec-on-event": false,
		"on-click": "mmsg dispatch switch_keyboard_layout"
	},
	
	// Updates: count from scripts/updates.sh; click lists them, right click installs
	"custom/pacman": {
		"format": "  {}",
		"return-type": "json",
		"exec": "~/.config/waybar/scripts/updates.sh pacman",
		"interval": 3600,
		"on-click": "pkill -SIGRTMIN+8 waybar",
		"on-click-right": "footclient --title=mango-update -e ~/.config/waybar/scripts/updates.sh upgrade",
		"signal": 8
	},

	"custom/aur": {
		"format": "  {}",
		"return-type": "json",
		"exec": "~/.config/waybar/scripts/updates.sh aur",
		"interval": 3600,
		"on-click": "pkill -SIGRTMIN+8 waybar",
		"on-click-right": "footclient --title='mango-update' -e sh -c 'yay -Sua; pkill -SIGRTMIN+8 waybar'",
		"signal": 8
	},

	"systemd-failed-units": {
		"hide-on-ok": true,
		"format": " {nr_failed}",
		"format-ok": "",
		"system": true,
		"user": true,
		"on-click-right": "footclient --title='mango-update' -e sh -c 'echo === SYSTEM FAILED ===; systemctl --failed; echo; echo === USER FAILED ===; systemctl --user --failed; echo; echo Press any key to close window...; read -n 1'"
	},

	// Webcam: driver unloaded (off), in use (active) or idle. Right click loads/unloads the driver.
	"custom/webcam": {
		"exec": "sh -c 'if ! lsmod | grep -q \"^uvcvideo\"; then echo \"{\\\"text\\\":\\\"\\\",\\\"tooltip\\\":\\\"<b>Webcam:</b> off (driver unloaded)\\n\\nRight click: turn on\\\",\\\"class\\\":\\\"off\\\"}\"; elif fuser /dev/video* >/dev/null 2>&1; then echo \"{\\\"text\\\":\\\"\\\",\\\"tooltip\\\":\\\"<b>Webcam:</b> in use\\n\\nRight click: turn off\\\",\\\"class\\\":\\\"active\\\"}\"; else echo \"{\\\"text\\\":\\\"\\\",\\\"tooltip\\\":\\\"<b>Webcam:</b> idle (driver loaded)\\n\\nRight click: turn off\\\",\\\"class\\\":\\\"idle\\\"}\"; fi'",
		"return-type": "json",
		"interval": 60,
		"on-click-right": "footclient --title='mango-update' -e sh -c 'if lsmod | grep -q uvcvideo; then sudo rmmod uvcvideo; else sudo modprobe uvcvideo; fi ; pkill -SIGRTMIN+9 waybar'",

		"signal": 9
	},

	// Firewall on/off; middle click opens the settings, right click toggles the service
	"custom/firewall": {
		"exec": "systemctl is-active firewalld >/dev/null && echo '{\"text\":\"\",\"class\":\"on\"}' || echo '{\"text\":\"\",\"class\":\"off\"}'",
		"return-type": "json",
		"interval": 60,
		"tooltip-format": "<b>Firewall:</b> firewalld\n\nMiddle click: settings\nRight click: on / off",
		"on-click-middle": "firewall-config",
		"on-click-right": "footclient --title='mango-update' -e sh -c 'if systemctl is-active firewalld >/dev/null; then sudo systemctl stop firewalld; else sudo systemctl start firewalld; fi ; pkill -SIGRTMIN+10 waybar'",
		"signal": 10
	},

	"wireplumber": {
		"scroll-step": 2, // %, can be a float
		"format": "{icon} {volume}%",
		"format-muted": " {volume}%",
		"format-icons": ["", "", ""],
		"tooltip-format": "Output: {node_name}\n\nLeft click: mute\nRight click: output (Super+Alt+S)\nScroll: volume",
		"on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
		"on-click-right": "sound output"
	},

	"wireplumber#source": {
		"node-type": "Audio/Source",
		"scroll-step": 2,
		"format": " {volume}%",
		"format-muted": " {volume}%",
		"tooltip-format": "Input: {node_name}\n\nLeft click: mute\nScroll: volume",
		"on-click": "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle"
	},

	"bluetooth": {
		"format": "{icon}",
		"format-icons": "",
		"format-disabled": "{icon}",
		"format-off": "{icon}",
		"format-connected": "{icon} {num_connections}",
		"tooltip-format": "<b>Bluetooth:</b> {controller_alias}\n\nLeft click: restart Bluetooth\nMiddle click: devices (Super+Alt+B)\nRight click: connect headphones again",
		"tooltip-format-connected": "<b>Bluetooth:</b> {controller_alias}\n\n{device_enumerate}\n\nLeft click: restart Bluetooth\nMiddle click: devices (Super+Alt+B)\nRight click: connect headphones again",
		"tooltip-format-enumerate-connected": "<b>{device_alias}</b>",
		"tooltip-format-enumerate-connected-battery": "<b>{device_alias}:</b> {device_battery_percentage}%",
		"on-click-middle": "net-menu bt",
		"on-click": "bt restart",
		"on-click-right": "bt headphones"
	},

	// No "interface": follows the default route, so Wi-Fi or a docked cable works on any computer
	"network": {
		"format-wifi": " {signalStrength}%",
		"format-alt": " ↓{bandwidthDownBytes} ↑{bandwidthUpBytes}",
		// The plain tooltip-format is also used after a left click (speed), so it has the Wi-Fi details
		"tooltip-format": "<b>Wi-Fi:</b> {essid}\n<b>Wlan card:</b> {ifname}\n<b>IP:</b> {ipaddr}/{cidr}\n<b>Signal:</b> {signaldBm} dBm\n<b>Frequency:</b> {frequency} GHz\n<b>Down:</b> {bandwidthDownBits} <b>Up:</b> {bandwidthUpBits}\n\nLeft click: speed\nMiddle click: nmtui\nRight click: Wi-Fi menu (Super+Alt+W)",
		"tooltip-format-ethernet": "<b>Network:</b> {ifname}\n<b>IP:</b> {ipaddr}/{cidr}\n<b>Down:</b> {bandwidthDownBits} <b>Up:</b> {bandwidthUpBits}\n\nLeft click: speed\nMiddle click: nmtui\nRight click: Wi-Fi menu (Super+Alt+W)",
		"format-disconnected": "",
		"format-disabled": "",
		"interval": 2,
		"format-icons": ["󰤟", "󰤢", "󰤥", "󰤨"],
		"format-ethernet": "",
		// nmtui draws once for the size at start, so it waits until mango has made the window small (windowrules.toml)
		"on-click-middle": "footclient --title=nmtui sh -c 'sleep 0.3; exec nmtui'",
		"on-click-right": "net-menu wifi"
	},

	// Time; the tooltip shows a calendar
	"clock": {
		"format": "{:L%H:%M:%S}",
		"format-alt": "{:L%H:%M}",
		"interval": 1,
		"tooltip": true,
		"tooltip-format": "<span font='Noto Sans Mono' size='11pt'>{calendar}</span>\n\nScroll: other months\nMiddle click: back to today\nRight click: month / year",
		"calendar": {
			"mode": "month",
			"mode-mon-col": 3,
			"iso8601": true,
			"on-scroll": 1,
			"weeks-pos": "left",
			"format": {
				"weeks": 		"<span color='#d8dee9'><b>{}</b></span>", // nordic light gray
				"months":   "<span color='#81a1c1'><b>{}</b></span>", // nordic blue
				"days":     "<span color='#81a1c1'><b>{}</b></span>", // nordic light blue
				"weekdays": "<span color='#d8dee9'><b>{}</b></span>", // nordic light gray
				"today":    "<span color='#a3be8c'><b>{}</b></span>", // nordic green
			}
		},
		"actions": {
			"on-click-right": "mode",
			"on-scroll-up": "shift_down",
			"on-scroll-down": "shift_up",
			"on-click-middle": "shift_reset"
		},
	},

	// No "bat": Waybar finds the battery itself
	"battery": {
		"states": {
			"good": 75,
			"warning": 30,
			"critical": 15
		},
		"events": {
			"on-discharging-warning": "notify-send -a battery 'Low Battery'",
			"on-discharging-critical": "notify-send -u critical -a battery 'Very Low Battery'",
			"on-charging-100": "notify-send -a battery 'Battery Full!'"
		},
		"format": "{capacity}% {icon}",
		"format-alt": "{power:.0f}W {icon}",
		"tooltip-format": "<b>Battery:</b> {timeTo}\n\nLeft click: watts",
		"format-icons": {"charging": [""], "plugged": [""], "default": ["","","","",""]},
	},

	// Left click locks, middle click reboots, right click powers off; all ask first
	"custom/power": {
		"format": "{icon}",
		"format-icons": {"default": [""]},
		"tooltip-format": "<b>Power</b>\n\nLeft click: lock (Super+L)\nMiddle click: reboot\nRight click: power off",
		"on-click": "power-confirm lock",
		"on-click-middle": "power-confirm reboot",
		"on-click-right": "power-confirm poweroff"
	}
}
