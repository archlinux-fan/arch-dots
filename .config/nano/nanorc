# --- INTERFACE & VIEW --------------------------------------------------------
set minibar             # Show a modern feedback bar at the bottom
set constantshow        # Constantly show cursor position (line, column)
set stateflags          # Show modified/view status in the top right corner
set nohelp              # Hide the two help lines at the bottom for more space
#set zero               # Use the entire terminal for editing (hides all bars)
#set emptyline          # Keep the line below the title bar empty

# --- BEHAVIOR & EDITING ------------------------------------------------------
set mouse               # Enable mouse support for clicking and scrolling
set zap                 # Let Backspace/Delete erase a marked region
set autoindent          # Indent new lines to the previous line's level
set tabsize 2           # Make a tab this number of columns wide
set noconvert           # Don't convert files from DOS/Mac format
set afterends           # Make Ctrl+Right stop at word ends instead of beginnings
#set showcursor         # Keep the cursor visible in file browser/help

# --- LINE WRAPPING -----------------------------------------------------------
set softwrap            # Display overlong lines on multiple rows
set atblanks            # Wrap lines at whitespace instead of at the edge

# --- COLORS & STYLING --------------------------------------------------------
set titlecolor     white,black    # Colors for the top title bar
set statuscolor    white,black    # Colors for the status bar
set numbercolor    cyan,black     # Colors for line numbers
set keycolor       cyan,black     # Colors for the shortcut key combos
set functioncolor  white,black    # Colors for the shortcut descriptions
set selectedcolor  black,yellow   # Colors for text marked with the mouse/keys
set spotlightcolor black,pink     # Colors for search matches and current line
set stripecolor    yellow         # Color for the vertical guiding bar
set errorcolor     black,red      # Color for error messages in the status bar

# --- KEY BINDINGS ------------------------------------------------------------
# bind ^S savefile main   # Bind Ctrl+S to save the current file
# bind ^Q exit main       # Bind Ctrl+Q to exit the editor
# bind ^F whereis main    # Bind Ctrl+F to find text

