#!/bin/bash
# Bluetooth fixes.
#   bt headphones  headphones connected but silent: connect them again
#   bt restart     mouse, keyboard or headphones won't connect: Bluetooth off and on
#                  (like the airplane key, but Wi-Fi stays on), headphones connect again
#   bt watch       started by mango: runs "bt headphones" when the music link hangs

# Talks to BlueZ over D-Bus with busctl (systemd), so bluetoothctl isn't needed.
dev() { busctl call org.bluez "$2" org.bluez.Device1 "$1" >/dev/null; }

# Connected audio devices (Audio Sink UUID), not a Bluetooth keyboard or mouse
audio() {
    busctl --json=short call org.bluez / org.freedesktop.DBus.ObjectManager GetManagedObjects |
        jq -r '.data[0] | to_entries[] | .value["org.bluez.Device1"] as $d | select($d.Connected.data
            and ($d.UUIDs.data | index("0000110b-0000-1000-8000-00805f9b34fb"))) | .key'
}

case $1 in
    headphones)
        for d in $(audio); do
            dev Disconnect "$d"; sleep 3
            dev Connect "$d" && notify-send --app-name=bluetooth "Headphones connected again"
        done ;;
    restart)
        devices=$(audio)
        rfkill block bluetooth; sleep 2; rfkill unblock bluetooth
        for i in 1 2 3 4 5; do busctl get-property org.bluez /org/bluez/hci0 org.bluez.Adapter1 Powered | grep -q true && break; sleep 1; done
        for d in $devices; do dev Connect "$d"; done
        notify-send --app-name=bluetooth "Bluetooth restarted" ;;
    watch)
        # Headphones and BlueZ sometimes start the music link at the same moment:
        # BlueZ logs "a2dp-sink profile connect failed ... busy" and the link hangs silent
        journalctl -u bluetooth -f -n 0 -o cat | while read -r line; do
            [[ $line == *"a2dp-sink profile connect failed"*busy* ]] && { sleep 2; "$0" headphones; }
        done ;;
    *) echo "Usage: bt headphones|restart|watch"; exit 1 ;;
esac
