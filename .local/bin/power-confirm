#!/bin/bash
# "Reboot?" / "Power off?" as a small fuzzel menu (Nord, ~/.config/fuzzel/fuzzel.ini),
# Cancel selected first: Enter or a click picks, Escape cancels.
# Used by keybindings.toml and the waybar power icon.
# Usage: power-confirm reboot|poweroff

case $1 in
    reboot)   question="Reboot?";    yes="Reboot" ;;
    poweroff) question="Power off?"; yes="Power off" ;;
    *)        exit 1 ;;
esac

choice=$(printf 'Cancel\n%s\n' "$yes" |
    fuzzel --dmenu --hide-prompt --no-icons --mesg "$question" --lines 2 --width 22)
[[ $choice == "$yes" ]] && systemctl "$1"
