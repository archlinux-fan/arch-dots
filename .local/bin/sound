#!/bin/bash
# Volume and microphone keys, with a notification showing the level.
# The output is the default device (see ~/.config/wireplumber), the mic the default input.
#   sound up | down | mute
#   sound mic-up | mic-down | mic-mute
#   sound output   pick the output in fuzzel; "Automatic" goes back to the best connected one

if [[ $1 == output ]]; then
    cur=$(wpctl inspect @DEFAULT_AUDIO_SINK@ | awk 'NR==1 {print $2+0}')
    # Outputs: id and name; a monitor by its own name ([DELL S2725QC])
    mapfile -t sinks < <(pw-dump | jq -r '.[] | select(.info.props["media.class"] == "Audio/Sink")
        | .info.props["node.description"] as $d | "\(.id)\t\($d | capture("\\[(?<m>.*)\\]$").m // $d)"')
    i=$({ for s in "${sinks[@]}"; do
            [[ ${s%%$'\t'*} == "$cur" ]] && echo "${s#*$'\t'}   ·   in use" || echo "${s#*$'\t'}"
          done; echo "Automatic (best connected)"; } |
        fuzzel --dmenu --index --only-match --no-icons --hide-prompt --mesg "Sound output" --lines 8 --minimal-lines --width 46) || exit
    if (( i == ${#sinks[@]} )); then
        wpctl clear-default && notify-send -a sound -i $HOME/.local/share/icons/Nordzy/status/scalable/notification-audio-volume-high.svg "Sound: automatic"
    else
        wpctl set-default "${sinks[i]%%$'\t'*}" && notify-send -a sound -i $HOME/.local/share/icons/Nordzy/status/scalable/notification-audio-volume-high.svg "Sound: ${sinks[i]#*$'\t'}"
    fi
    exit
fi

case $1 in
    up|down|mute) dev=@DEFAULT_AUDIO_SINK@;   name=Volume; app=volume;     icon=notification-audio-volume ;;
    mic-*)        dev=@DEFAULT_AUDIO_SOURCE@; name=Mic;    app=mic-volume; icon=notification-microphone-sensitivity ;;
esac

case $1 in
    up|mic-up)     wpctl set-mute $dev 0; wpctl set-volume -l 1.0 $dev 5%+ ;;
    down|mic-down) wpctl set-mute $dev 0; wpctl set-volume $dev 5%- ;;
    mute|mic-mute) wpctl set-mute $dev toggle ;;
    *) echo "Usage: sound up|down|mute|mic-up|mic-down|mic-mute|output"; exit 1 ;;
esac

out=$(wpctl get-volume $dev) || exit
v=$(awk '{printf "%.0f", $2*100}' <<< "$out")
# Icon: a light Nordzy notification-* one, by full path (mako finds no names in Nordzy's folders): muted, or low / medium / high by the level
case $out in
    *MUTED*) text="$name: muted"; l=muted ;;
    *) text="$name: $v%"; l=high; ((v < 67)) && l=medium; ((v < 34)) && l=low; ((v == 0)) && l=muted ;;
esac
notify-send -h string:x-canonical-private-synchronous:$app -h int:value:$v -t 2000 -i $HOME/.local/share/icons/Nordzy/status/scalable/$icon-$l.svg --app-name=$app "$text"
